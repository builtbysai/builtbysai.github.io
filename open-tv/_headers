/*
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: http: data:; media-src https: http: blob:; connect-src 'self' https: http:; worker-src 'self' blob:; frame-src https: http:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/catalog/world-live.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/catalog/open-cinema.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/catalog/update-manifest.json
  Cache-Control: no-store
  Access-Control-Allow-Origin: *
/catalog/releases/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
/index.html
  Cache-Control: no-cache
/legacy.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-store
/fonts/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
